 "transcript": [
  {
   "start_ms": 0,
   "end_ms": 1520,
   "snippet": "इन्वेस्टमेंट इन द सिक्योरिटीज़ मार्केट इज़",
   "start_time_text": "0:00",
   "start_time_label": "0:00"
  },
  {
   "start_ms": 1520,
   "end_ms": 2879,
   "snippet": "सब्जेक्ट टू मार्केट रिस्क। इन्वेस्टर्स",
   "start_time_text": "0:01",
   "start_time_label": "0:01"
  },
  {
   "start_ms": 2879,
   "end_ms": 4400,
   "snippet": "आर एडवाइस टू रीड ऑल रिलेटेड डॉक्यूमेंट्स",
   "start_time_text": "0:02",
   "start_time_label": "0:02"
  },
  {
   "start_ms": 4400,
   "end_ms": 8120,
   "snippet": "केयरफरली बिफोर इन्वेस्टिंग।",
   "start_time_text": "0:04",
   "start_time_label": "0:04"
  },
  {
   "start_ms": 10080,
   "end_ms": 12639,
   "snippet": "नमस्कार। व्हिच स्टॉक्स टू सेल, व्हिच",
   "start_time_text": "0:10",
   "start_time_label": "0:10"
  },
  {
   "start_ms": 12639,
   "end_ms": 15120,
   "snippet": "स्टॉक्स टू बाय। पार्ट टू। आज हम",
   "start_time_text": "0:12",
   "start_time_label": "0:12"
  },
  {
   "start_ms": 15120,
   "end_ms": 17440,
   "snippet": "स्पेसिफिकली डिस्कस करने वाले हैं 10 तरह",
   "start_time_text": "0:15",
   "start_time_label": "0:15"
  },
  {
   "start_ms": 17440,
   "end_ms": 20080,
   "snippet": "के स्टॉक्स जो आप खरीदने का सोच सकते हैं।",
   "start_time_text": "0:17",
   "start_time_label": "0:17"
  },
  {
   "start_ms": 20080,
   "end_ms": 22000,
   "snippet": "उन्हें कंसीडर कर सकते हैं। ब्लाइंडली इन",
   "start_time_text": "0:20",
   "start_time_label": "0:20"
  },
  {
   "start_ms": 22000,
   "end_ms": 24160,
   "snippet": "फैक्टर्स पे नहीं जाना है लेकिन यह",
   "start_time_text": "0:22",
   "start_time_label": "0:22"
  },
  {
   "start_ms": 24160,
   "end_ms": 27439,
   "snippet": "पॉजिटिव साइन हैं। यह आप आइडेंटिफाई कर",
   "start_time_text": "0:24",
   "start_time_label": "0:24"
  },
  {
   "start_ms": 27439,
   "end_ms": 29279,
   "snippet": "सकते हैं। इसमें से जितने ज्यादा पॉइंटर्स",
   "start_time_text": "0:27",
   "start_time_label": "0:27"
  },
  {
   "start_ms": 29279,
   "end_ms": 32320,
   "snippet": "हो उतना ज्यादा पॉजिटिव है मेरे लिए वो",
   "start_time_text": "0:29",
   "start_time_label": "0:29"
  },
  {
   "start_ms": 32320,
   "end_ms": 35360,
   "snippet": "कंपनी। अगर आप यह सब नहीं चाहते हैं, आप",
   "start_time_text": "0:32",
   "start_time_label": "0:32"
  },
  {
   "start_ms": 35360,
   "end_ms": 37760,
   "snippet": "चाहते हैं कि ट्रस्टेड रिसर्च आपको मिले",
   "start_time_text": "0:35",
   "start_time_label": "0:35"
  },
  {
   "start_ms": 37760,
   "end_ms": 40079,
   "snippet": "महीने के दो-तीन स्टॉक रिकमेंडेशंस और साल",
   "start_time_text": "0:37",
   "start_time_label": "0:37"
  },
  {
   "start_ms": 40079,
   "end_ms": 42000,
   "snippet": "भर में आपका 30 स्टॉक्स का पोर्टफोलियो",
   "start_time_text": "0:40",
   "start_time_label": "0:40"
  },
  {
   "start_ms": 42000,
   "end_ms": 44559,
   "snippet": "बने, तो फिनोलॉजी 30 का लिंक इस वीडियो के",
   "start_time_text": "0:42",
   "start_time_label": "0:42"
  },
  {
   "start_ms": 44559,
   "end_ms": 47760,
   "snippet": "डिस्क्रिप्शन में है। पहला ऐसे समय में जब",
   "start_time_text": "0:44",
   "start_time_label": "0:44"
  },
  {
   "start_ms": 47760,
   "end_ms": 50559,
   "snippet": "स्टॉक्स में वैल्यू है, बहुत सारे स्टॉक्स",
   "start_time_text": "0:47",
   "start_time_label": "0:47"
  },
  {
   "start_ms": 50559,
   "end_ms": 53280,
   "snippet": "या तो अपने 52 वीक लो में है, कई तो मल्टी",
   "start_time_text": "0:50",
   "start_time_label": "0:50"
  },
  {
   "start_ms": 53280,
   "end_ms": 56640,
   "snippet": "ईयर लो में हैं और वैल्यू्यूएशंस रीज़नेबल",
   "start_time_text": "0:53",
   "start_time_label": "0:53"
  },
  {
   "start_ms": 56640,
   "end_ms": 59039,
   "snippet": "है। जब इंडेक्स का वैल्यू्यूएशन ही 20 के",
   "start_time_text": "0:56",
   "start_time_label": "0:56"
  },
  {
   "start_ms": 59039,
   "end_ms": 61359,
   "snippet": "आसपास है। यानी बहुत समय बाद हम",
   "start_time_text": "0:59",
   "start_time_label": "0:59"
  },
  {
   "start_ms": 61359,
   "end_ms": 64400,
   "snippet": "ओवरवैल्यूड टेरिटरी से नीचे आए हैं। तो",
   "start_time_text": "1:01",
   "start_time_label": "1:01"
  },
  {
   "start_ms": 64400,
   "end_ms": 66880,
   "snippet": "इंडेक्स के अलावा बाकी स्टॉक्स में तो अब",
   "start_time_text": "1:04",
   "start_time_label": "1:04"
  },
  {
   "start_ms": 66880,
   "end_ms": 71200,
   "snippet": "वैल्यू है। ऐसे समय में अगर प्रमोटर्स",
   "start_time_text": "1:06",
   "start_time_label": "1:06"
  },
  {
   "start_ms": 71200,
   "end_ms": 74400,
   "snippet": "अपनी होल्डिंग नहीं बढ़ा रहे हैं तो मेरे",
   "start_time_text": "1:11",
   "start_time_label": "1:11"
  },
  {
   "start_ms": 74400,
   "end_ms": 76400,
   "snippet": "को स्टॉक में कॉन्फिडेंस नहीं आएगा। ऐसे",
   "start_time_text": "1:14",
   "start_time_label": "1:14"
  },
  {
   "start_ms": 76400,
   "end_ms": 78799,
   "snippet": "समय में अगर प्रमोटर्स स्टॉक्स अपने बेच",
   "start_time_text": "1:16",
   "start_time_label": "1:16"
  },
  {
   "start_ms": 78799,
   "end_ms": 80400,
   "snippet": "रहे हैं कंपनी के तब तो वो बहुत ही रेड",
   "start_time_text": "1:18",
   "start_time_label": "1:18"
  },
  {
   "start_ms": 80400,
   "end_ms": 83280,
   "snippet": "फ्लैग है। लेकिन आई एम लुकिंग फॉर प्रमोटर",
   "start_time_text": "1:20",
   "start_time_label": "1:20"
  },
  {
   "start_ms": 83280,
   "end_ms": 86799,
   "snippet": "बाइंग। प्रमोटर कंपनी का इंसाइडर है। उसके",
   "start_time_text": "1:23",
   "start_time_label": "1:23"
  },
  {
   "start_ms": 86799,
   "end_ms": 89200,
   "snippet": "एक्शंस अगर ऐसे हैं कि उसे अपने बिजनेस",
   "start_time_text": "1:26",
   "start_time_label": "1:26"
  },
  {
   "start_ms": 89200,
   "end_ms": 91600,
   "snippet": "में भरोसा है और वह सब्सटैंशियल बाइंग कर",
   "start_time_text": "1:29",
   "start_time_label": "1:29"
  },
  {
   "start_ms": 91600,
   "end_ms": 93920,
   "snippet": "रहा है। सिर्फ ऑप्टिकली नहीं कि थोड़ा सा",
   "start_time_text": "1:31",
   "start_time_label": "1:31"
  },
  {
   "start_ms": 93920,
   "end_ms": 96560,
   "snippet": "खरीद लिया ताकि 1% शेयर होल्डिंग बढ़ती",
   "start_time_text": "1:33",
   "start_time_label": "1:33"
  },
  {
   "start_ms": 96560,
   "end_ms": 99280,
   "snippet": "हुई दिख जाए। यह तो ऑप्टिक्स की बात है।",
   "start_time_text": "1:36",
   "start_time_label": "1:36"
  },
  {
   "start_ms": 99280,
   "end_ms": 101360,
   "snippet": "लेकिन सच में अगर पिछले दो क्वार्टर्स में",
   "start_time_text": "1:39",
   "start_time_label": "1:39"
  },
  {
   "start_ms": 101360,
   "end_ms": 103840,
   "snippet": "कंसीडरेबल शेयर होल्डिंग बढ़ी है",
   "start_time_text": "1:41",
   "start_time_label": "1:41"
  },
  {
   "start_ms": 103840,
   "end_ms": 105840,
   "snippet": "प्रमोटर्स की देन इट्स अ ग्रीन फ्लैग।",
   "start_time_text": "1:43",
   "start_time_label": "1:43"
  },
  {
   "start_ms": 105840,
   "end_ms": 107680,
   "snippet": "अकेले आइसोलेशन में मैं यह देख के नहीं",
   "start_time_text": "1:45",
   "start_time_label": "1:45"
  },
  {
   "start_ms": 107680,
   "end_ms": 110079,
   "snippet": "खरीदूंगा स्टॉक्स। इसके साथ बाकी फैक्टर्स",
   "start_time_text": "1:47",
   "start_time_label": "1:47"
  },
  {
   "start_ms": 110079,
   "end_ms": 112240,
   "snippet": "भी जरूरी हैं। लेकिन यह वन ऑफ द",
   "start_time_text": "1:50",
   "start_time_label": "1:50"
  },
  {
   "start_ms": 112240,
   "end_ms": 114320,
   "snippet": "इंपॉर्टेंट फैक्टर्स हैं। तो पहला यह हुआ।",
   "start_time_text": "1:52",
   "start_time_label": "1:52"
  },
  {
   "start_ms": 114320,
   "end_ms": 117759,
   "snippet": "दूसरा उस कंपनी का बिजनेस हाईली फोकस्ड",
   "start_time_text": "1:54",
   "start_time_label": "1:54"
  },
  {
   "start_ms": 117759,
   "end_ms": 120960,
   "snippet": "है। वो एक काम करते हैं और एक काम बहुत",
   "start_time_text": "1:57",
   "start_time_label": "1:57"
  },
  {
   "start_ms": 120960,
   "end_ms": 123280,
   "snippet": "अच्छे से करते हैं। वो बहुत अलग-अलग",
   "start_time_text": "2:00",
   "start_time_label": "2:00"
  },
  {
   "start_ms": 123280,
   "end_ms": 125200,
   "snippet": "इंडस्ट्रीज में डवर्सिफाई नहीं कर रहे या",
   "start_time_text": "2:03",
   "start_time_label": "2:03"
  },
  {
   "start_ms": 125200,
   "end_ms": 127200,
   "snippet": "फिर अभी कॉन कॉल्स में, इन्वेस्टर",
   "start_time_text": "2:05",
   "start_time_label": "2:05"
  },
  {
   "start_ms": 127200,
   "end_ms": 130080,
   "snippet": "प्रेजेंटेशंस में आपको और मुझे सांत्वना",
   "start_time_text": "2:07",
   "start_time_label": "2:07"
  },
  {
   "start_ms": 130080,
   "end_ms": 132720,
   "snippet": "देने के लिए, धीरज बंधाने के लिए इधर-उधर",
   "start_time_text": "2:10",
   "start_time_label": "2:10"
  },
  {
   "start_ms": 132720,
   "end_ms": 134560,
   "snippet": "की बातें नहीं कर रहे कि ठीक है, हमारा ए",
   "start_time_text": "2:12",
   "start_time_label": "2:12"
  },
  {
   "start_ms": 134560,
   "end_ms": 136239,
   "snippet": "सेगमेंट अच्छा नहीं कर रहा, बी अच्छा नहीं",
   "start_time_text": "2:14",
   "start_time_label": "2:14"
  },
  {
   "start_ms": 136239,
   "end_ms": 138560,
   "snippet": "कर रहा। एक हमारा ना सी सेगमेंट भी है जो",
   "start_time_text": "2:16",
   "start_time_label": "2:16"
  },
  {
   "start_ms": 138560,
   "end_ms": 140800,
   "snippet": "अब हम रैंप अप करने वाले हैं वो अच्छा",
   "start_time_text": "2:18",
   "start_time_label": "2:18"
  },
  {
   "start_ms": 140800,
   "end_ms": 144080,
   "snippet": "करेगा देखना देखना बिजनेस अच्छा करेगा ऐसे",
   "start_time_text": "2:20",
   "start_time_label": "2:20"
  },
  {
   "start_ms": 144080,
   "end_ms": 147040,
   "snippet": "बिनेसेस से दूर रहना आई वुड प्रेफर कि अभी",
   "start_time_text": "2:24",
   "start_time_label": "2:24"
  },
  {
   "start_ms": 147040,
   "end_ms": 149360,
   "snippet": "मैनेजमेंट का फोकस इस बात पे रहे कि हम",
   "start_time_text": "2:27",
   "start_time_label": "2:27"
  },
  {
   "start_ms": 149360,
   "end_ms": 152080,
   "snippet": "कैश कंजर्व करेंगे हम एडवरटाइजिंग कॉस्ट",
   "start_time_text": "2:29",
   "start_time_label": "2:29"
  },
  {
   "start_ms": 152080,
   "end_ms": 155040,
   "snippet": "मार्केटिंग कॉस्ट कंजर्व करेंगे हम बुरे",
   "start_time_text": "2:32",
   "start_time_label": "2:32"
  },
  {
   "start_ms": 155040,
   "end_ms": 157360,
   "snippet": "समय के लिए अपने आपको और अच्छे से तैयार",
   "start_time_text": "2:35",
   "start_time_label": "2:35"
  },
  {
   "start_ms": 157360,
   "end_ms": 160800,
   "snippet": "रखेंगे और ऑनेस्टली इस बात को माने कि हां",
   "start_time_text": "2:37",
   "start_time_label": "2:37"
  },
  {
   "start_ms": 160800,
   "end_ms": 163680,
   "snippet": "बिजनेस में टेंपरेरी प्रॉब्लम्स हैं और हम",
   "start_time_text": "2:40",
   "start_time_label": "2:40"
  },
  {
   "start_ms": 163680,
   "end_ms": 165760,
   "snippet": "यह यह एक्शननेबल स्टेप्स ले रहे हैं उनको",
   "start_time_text": "2:43",
   "start_time_label": "2:43"
  },
  {
   "start_ms": 165760,
   "end_ms": 168239,
   "snippet": "रिॉल्व करने के लिए आई एम लुकिंग फॉर",
   "start_time_text": "2:45",
   "start_time_label": "2:45"
  },
  {
   "start_ms": 168239,
   "end_ms": 172080,
   "snippet": "इंक्रीज्ड फोकस ना कि इनक्रीज्ड नॉइज़। यह",
   "start_time_text": "2:48",
   "start_time_label": "2:48"
  },
  {
   "start_ms": 172080,
   "end_ms": 174000,
   "snippet": "जिन भी कंपनियों को आप ले रहे हो उनकी",
   "start_time_text": "2:52",
   "start_time_label": "2:52"
  },
  {
   "start_ms": 174000,
   "end_ms": 176800,
   "snippet": "मैनेजमेंट कमेंट्री में आइडेंटिफाई करने",
   "start_time_text": "2:54",
   "start_time_label": "2:54"
  },
  {
   "start_ms": 176800,
   "end_ms": 180080,
   "snippet": "की कोशिश करिएगा। तीसरा आई लव बिनेसेस जो",
   "start_time_text": "2:56",
   "start_time_label": "2:56"
  },
  {
   "start_ms": 180080,
   "end_ms": 182640,
   "snippet": "कमोडिटीज को ब्रांड में कन्वर्ट करके",
   "start_time_text": "3:00",
   "start_time_label": "3:00"
  },
  {
   "start_ms": 182640,
   "end_ms": 186720,
   "snippet": "बिजनेस बनाएं। डिस्क्लोज़र मैं इन्वेस्टेड",
   "start_time_text": "3:02",
   "start_time_label": "3:02"
  },
  {
   "start_ms": 186720,
   "end_ms": 188400,
   "snippet": "नहीं हूं। हमने क्लाइंट्स को इन्वेस्ट",
   "start_time_text": "3:06",
   "start_time_label": "3:06"
  },
  {
   "start_ms": 188400,
   "end_ms": 190800,
   "snippet": "नहीं किया है। यह सिर्फ एक एग्जांपल है।",
   "start_time_text": "3:08",
   "start_time_label": "3:08"
  },
  {
   "start_ms": 190800,
   "end_ms": 196080,
   "snippet": "जैसे एमआरएफ, टायर्स, रबर यह कमोडिटी है।",
   "start_time_text": "3:10",
   "start_time_label": "3:10"
  },
  {
   "start_ms": 196080,
   "end_ms": 198400,
   "snippet": "लेकिन जब आप रिप्लेसमेंट मार्केट में टायर",
   "start_time_text": "3:16",
   "start_time_label": "3:16"
  },
  {
   "start_ms": 198400,
   "end_ms": 201599,
   "snippet": "खरीदने जाते हो खास करके यंगस्टर्स तो वो",
   "start_time_text": "3:18",
   "start_time_label": "3:18"
  },
  {
   "start_ms": 201599,
   "end_ms": 204159,
   "snippet": "सामने से मांगते हैं कि एमआरएफ का टायर",
   "start_time_text": "3:21",
   "start_time_label": "3:21"
  },
  {
   "start_ms": 204159,
   "end_ms": 206000,
   "snippet": "दो। यह बहुत अनयूजुअल है। दुनिया में ऐसा",
   "start_time_text": "3:24",
   "start_time_label": "3:24"
  },
  {
   "start_ms": 206000,
   "end_ms": 208400,
   "snippet": "ज्यादा होता नहीं है कि आप ब्रांडेड टायर",
   "start_time_text": "3:26",
   "start_time_label": "3:26"
  },
  {
   "start_ms": 208400,
   "end_ms": 211680,
   "snippet": "मांग रहे हो। कमोडिटी है वो। एमआरएफ ने यह",
   "start_time_text": "3:28",
   "start_time_label": "3:28"
  },
  {
   "start_ms": 211680,
   "end_ms": 215120,
   "snippet": "सक्सेसफुली किया है कि उसने एक कमोडिटी को",
   "start_time_text": "3:31",
   "start_time_label": "3:31"
  },
  {
   "start_ms": 215120,
   "end_ms": 217040,
   "snippet": "ब्रांड बना दिया है। जिसके कारण",
   "start_time_text": "3:35",
   "start_time_label": "3:35"
  },
  {
   "start_ms": 217040,
   "end_ms": 218799,
   "snippet": "रिप्लेसमेंट मार्केट में वो हाई डिमांड",
   "start_time_text": "3:37",
   "start_time_label": "3:37"
  },
  {
   "start_ms": 218799,
   "end_ms": 221599,
   "snippet": "एंजॉय करता है और जो एमआरएफ की लेगसी रही",
   "start_time_text": "3:38",
   "start_time_label": "3:38"
  },
  {
   "start_ms": 221599,
   "end_ms": 225280,
   "snippet": "है वो आप जानते हो। अगेन यह एक एग्जांपल",
   "start_time_text": "3:41",
   "start_time_label": "3:41"
  },
  {
   "start_ms": 225280,
   "end_ms": 227760,
   "snippet": "है। लेकिन ऐसा अलग-अलग इंडस्ट्रीज में कई",
   "start_time_text": "3:45",
   "start_time_label": "3:45"
  },
  {
   "start_ms": 227760,
   "end_ms": 230560,
   "snippet": "बिजनेसेस ने सक्सेसफुली किया है कि जिसमें",
   "start_time_text": "3:47",
   "start_time_label": "3:47"
  },
  {
   "start_ms": 230560,
   "end_ms": 232879,
   "snippet": "आपको मार्जिन के लिए ₹1 एक के लिए लड़ना",
   "start_time_text": "3:50",
   "start_time_label": "3:50"
  },
  {
   "start_ms": 232879,
   "end_ms": 235920,
   "snippet": "पड़ता था। वहां आपने ब्रांडिंग ऐसी की,",
   "start_time_text": "3:52",
   "start_time_label": "3:52"
  },
  {
   "start_ms": 235920,
   "end_ms": 238400,
   "snippet": "पर्सव्ड वैल्यू ऐसी क्रिएट की कि आप",
   "start_time_text": "3:55",
   "start_time_label": "3:55"
  },
  {
   "start_ms": 238400,
   "end_ms": 240640,
   "snippet": "प्रीमियम चार्ज कर पा रहे हो। तो आई एम",
   "start_time_text": "3:58",
   "start_time_label": "3:58"
  },
  {
   "start_ms": 240640,
   "end_ms": 243519,
   "snippet": "इंक्रीजिंगली लुकिंग फॉर ऐसे ब्रांड्स जो",
   "start_time_text": "4:00",
   "start_time_label": "4:00"
  },
  {
   "start_ms": 243519,
   "end_ms": 245760,
   "snippet": "सिर्फ कमोडिटी प्राइसेस के भरोसे उनका",
   "start_time_text": "4:03",
   "start_time_label": "4:03"
  },
  {
   "start_ms": 245760,
   "end_ms": 248159,
   "snippet": "सारा जीवन ना हो। वरना उनके रॉ मटेरियल के",
   "start_time_text": "4:05",
   "start_time_label": "4:05"
  },
  {
   "start_ms": 248159,
   "end_ms": 250480,
   "snippet": "प्राइस बढ़ जाए तो कंपनियां मर जाएं। तो",
   "start_time_text": "4:08",
   "start_time_label": "4:08"
  },
  {
   "start_ms": 250480,
   "end_ms": 253120,
   "snippet": "ऐसी कंपनीज़ नहीं चाहिए। कंपनीज़ ऐसी हो",
   "start_time_text": "4:10",
   "start_time_label": "4:10"
  },
  {
   "start_ms": 253120,
   "end_ms": 255519,
   "snippet": "जिनका मार्जिन इतना हो कि वह इनक्रीस",
   "start_time_text": "4:13",
   "start_time_label": "4:13"
  },
  {
   "start_ms": 255519,
   "end_ms": 258079,
   "snippet": "प्राइसेस को या तो अब्सॉर्ब कर सकके या",
   "start_time_text": "4:15",
   "start_time_label": "4:15"
  },
  {
   "start_ms": 258079,
   "end_ms": 260400,
   "snippet": "अपने कस्टमर्स को पास ऑन कर सकके और अपने",
   "start_time_text": "4:18",
   "start_time_label": "4:18"
  },
  {
   "start_ms": 260400,
   "end_ms": 262960,
   "snippet": "बिजनेस को हेल्दी तरीके से चलाते रह सकें।",
   "start_time_text": "4:20",
   "start_time_label": "4:20"
  },
  {
   "start_ms": 262960,
   "end_ms": 266000,
   "snippet": "चौथा आई एम नॉट लुकिंग फॉर प्रमोटर्स",
   "start_time_text": "4:22",
   "start_time_label": "4:22"
  },
  {
   "start_ms": 266000,
   "end_ms": 268880,
   "snippet": "जिनको बस वीसी का पैसा लेके एग्जिट पे",
   "start_time_text": "4:26",
   "start_time_label": "4:26"
  },
  {
   "start_ms": 268880,
   "end_ms": 270880,
   "snippet": "एग्जिट करना है। सेकंड वेंचर, थर्ड वेंचर,",
   "start_time_text": "4:28",
   "start_time_label": "4:28"
  },
  {
   "start_ms": 270880,
   "end_ms": 272960,
   "snippet": "फोर्थ वेंचर करना है। 5- 10-10 साल का",
   "start_time_text": "4:30",
   "start_time_label": "4:30"
  },
  {
   "start_ms": 272960,
   "end_ms": 276000,
   "snippet": "उनका एग्जिट साइकिल है। वो अपने लिए वेल्थ",
   "start_time_text": "4:32",
   "start_time_label": "4:32"
  },
  {
   "start_ms": 276000,
   "end_ms": 277840,
   "snippet": "क्रिएट कर रहे हैं। आई एम लुकिंग फॉर",
   "start_time_text": "4:36",
   "start_time_label": "4:36"
  },
  {
   "start_ms": 277840,
   "end_ms": 280639,
   "snippet": "प्रमोटर्स जो लेगसी बिल्ड करना चाहते हैं।",
   "start_time_text": "4:37",
   "start_time_label": "4:37"
  },
  {
   "start_ms": 280639,
   "end_ms": 282479,
   "snippet": "जो एग्जिट के लिए बिज़नेस में नहीं है,",
   "start_time_text": "4:40",
   "start_time_label": "4:40"
  },
  {
   "start_ms": 282479,
   "end_ms": 284720,
   "snippet": "एग्जीक्यूशन के लिए बिज़नेस में हैं। आई एम",
   "start_time_text": "4:42",
   "start_time_label": "4:42"
  },
  {
   "start_ms": 284720,
   "end_ms": 288400,
   "snippet": "लुकिंग फॉर एग्जीक्यूशन फोकस्ड प्रमोटर्स।",
   "start_time_text": "4:44",
   "start_time_label": "4:44"
  },
  {
   "start_ms": 288400,
   "end_ms": 291360,
   "snippet": "जो वो काम इसलिए कर रहे हैं कि वो बहुत",
   "start_time_text": "4:48",
   "start_time_label": "4:48"
  },
  {
   "start_ms": 291360,
   "end_ms": 294080,
   "snippet": "पैशनेट हैं उसको लेके। इसलिए नहीं कि आजकल",
   "start_time_text": "4:51",
   "start_time_label": "4:51"
  },
  {
   "start_ms": 294080,
   "end_ms": 295919,
   "snippet": "ये सेक्टर बूम में है। इसमें कुछ बनाते",
   "start_time_text": "4:54",
   "start_time_label": "4:54"
  },
  {
   "start_ms": 295919,
   "end_ms": 298000,
   "snippet": "हैं। ब्लिड स्केलिंग करते हैं, एग्जिट",
   "start_time_text": "4:55",
   "start_time_label": "4:55"
  },
  {
   "start_ms": 298000,
   "end_ms": 301520,
   "snippet": "लेते हैं। मैं मल्टीजनरेशन बिजनेस जिन",
   "start_time_text": "4:58",
   "start_time_label": "4:58"
  },
  {
   "start_ms": 301520,
   "end_ms": 304560,
   "snippet": "प्रमोटर्स ने बनाया है, आई एम लुकिंग फॉर",
   "start_time_text": "5:01",
   "start_time_label": "5:01"
  },
  {
   "start_ms": 304560,
   "end_ms": 307759,
   "snippet": "सच काइंड ऑफ कंपनीज़। तो बुरे समय में आप",
   "start_time_text": "5:04",
   "start_time_label": "5:04"
  },
  {
   "start_ms": 307759,
   "end_ms": 310000,
   "snippet": "किन लोगों को अपना पैसा दे रहे हो यह बहुत",
   "start_time_text": "5:07",
   "start_time_label": "5:07"
  },
  {
   "start_ms": 310000,
   "end_ms": 311680,
   "snippet": "जरूरी होता है। डेली लाइफ में भी हम देखते",
   "start_time_text": "5:10",
   "start_time_label": "5:10"
  },
  {
   "start_ms": 311680,
   "end_ms": 314479,
   "snippet": "हैं कि हम ₹10,000 उधार भी किसको दे रहे",
   "start_time_text": "5:11",
   "start_time_label": "5:11"
  },
  {
   "start_ms": 314479,
   "end_ms": 316880,
   "snippet": "हैं यह सोच समझ के देते हैं। जब हम स्टॉक",
   "start_time_text": "5:14",
   "start_time_label": "5:14"
  },
  {
   "start_ms": 316880,
   "end_ms": 318479,
   "snippet": "मार्केट में पैसे लगाते हैं ना, तो हम",
   "start_time_text": "5:16",
   "start_time_label": "5:16"
  },
  {
   "start_ms": 318479,
   "end_ms": 321039,
   "snippet": "हजारों लाखों रुपए लगाते हैं। लेकिन हम उस",
   "start_time_text": "5:18",
   "start_time_label": "5:18"
  },
  {
   "start_ms": 321039,
   "end_ms": 322880,
   "snippet": "इंसान को अच्छे से स्टडी नहीं करते जो उस",
   "start_time_text": "5:21",
   "start_time_label": "5:21"
  },
  {
   "start_ms": 322880,
   "end_ms": 324720,
   "snippet": "कंपनी को चला रहा है। मार्केट में भी आप",
   "start_time_text": "5:22",
   "start_time_label": "5:22"
  },
  {
   "start_ms": 324720,
   "end_ms": 326800,
   "snippet": "अपना पैसा किसी बिजनेस को दे रहे हो ना वो",
   "start_time_text": "5:24",
   "start_time_label": "5:24"
  },
  {
   "start_ms": 326800,
   "end_ms": 329120,
   "snippet": "बिजनेस कोई इंसान चला रहा है ना तो जिस",
   "start_time_text": "5:26",
   "start_time_label": "5:26"
  },
  {
   "start_ms": 329120,
   "end_ms": 331120,
   "snippet": "इंसान को दे रहे हो उसके बारे में जान तो",
   "start_time_text": "5:29",
   "start_time_label": "5:29"
  },
  {
   "start_ms": 331120,
   "end_ms": 332960,
   "snippet": "लो। उसकी हिस्ट्री, उसकी फैमिली की",
   "start_time_text": "5:31",
   "start_time_label": "5:31"
  },
  {
   "start_ms": 332960,
   "end_ms": 334880,
   "snippet": "हिस्ट्री, बिज़नेस इन्होंने कैसे चलाया है?",
   "start_time_text": "5:32",
   "start_time_label": "5:32"
  },
  {
   "start_ms": 334880,
   "end_ms": 336960,
   "snippet": "पास्ट क्या रहा है? क्या हमेशा सिर्फ",
   "start_time_text": "5:34",
   "start_time_label": "5:34"
  },
  {
   "start_ms": 336960,
   "end_ms": 339120,
   "snippet": "मोमेंटम चज़ करते हैं? या एक ही बिजनेस को",
   "start_time_text": "5:36",
   "start_time_label": "5:36"
  },
  {
   "start_ms": 339120,
   "end_ms": 341840,
   "snippet": "20 साल, 30 साल दिए हैं उन लोगों ने? यह",
   "start_time_text": "5:39",
   "start_time_label": "5:39"
  },
  {
   "start_ms": 341840,
   "end_ms": 344400,
   "snippet": "सबका ध्यान रखना है ऐसे समय में। पांचवा",
   "start_time_text": "5:41",
   "start_time_label": "5:41"
  },
  {
   "start_ms": 344400,
   "end_ms": 347680,
   "snippet": "आई एम लुकिंग फॉर कंपनीज़ हु आर पैराइड,",
   "start_time_text": "5:44",
   "start_time_label": "5:44"
  },
  {
   "start_ms": 347680,
   "end_ms": 350320,
   "snippet": "ऑब्सेस्ड अबाउट सेफ्टी ऑफ़ देयर बिज़नेस। हु",
   "start_time_text": "5:47",
   "start_time_label": "5:47"
  },
  {
   "start_ms": 350320,
   "end_ms": 352960,
   "snippet": "आर ऑब्सेस्ड अबाउट ट्राइंग टू मिटिगेट",
   "start_time_text": "5:50",
   "start_time_label": "5:50"
  },
  {
   "start_ms": 352960,
   "end_ms": 355360,
   "snippet": "एव्री बिनेस रिस्क। वो जहां रिस्क देखते",
   "start_time_text": "5:52",
   "start_time_label": "5:52"
  },
  {
   "start_ms": 355360,
   "end_ms": 357440,
   "snippet": "हैं उसको कंट्रोल या मिटिगेट करने की",
   "start_time_text": "5:55",
   "start_time_label": "5:55"
  },
  {
   "start_ms": 357440,
   "end_ms": 360160,
   "snippet": "कोशिश करते हैं ना कि ओवर लेवरेज होके",
   "start_time_text": "5:57",
   "start_time_label": "5:57"
  },
  {
   "start_ms": 360160,
   "end_ms": 362960,
   "snippet": "ज्यादा रिस्क लेके ज्यादा रैपिड ग्रोथ",
   "start_time_text": "6:00",
   "start_time_label": "6:00"
  },
  {
   "start_ms": 362960,
   "end_ms": 365919,
   "snippet": "करने की कोशिश करते हैं। खराब समय इट्स",
   "start_time_text": "6:02",
   "start_time_label": "6:02"
  },
  {
   "start_ms": 365919,
   "end_ms": 369199,
   "snippet": "अबाउट प्रिजर्वेशन। तो आई एम लुकिंग फॉर",
   "start_time_text": "6:05",
   "start_time_label": "6:05"
  },
  {
   "start_ms": 369199,
   "end_ms": 371919,
   "snippet": "बिनेसेस जिनमें ना यह सेफ्टी ऑबसेशन मुझे",
   "start_time_text": "6:09",
