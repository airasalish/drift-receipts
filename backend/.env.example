DATABASE_URL=sqlite:///./watchlist.db
POLL_INTERVAL_SECONDS=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Powers the "Explain this" button (services/digest.py) -- purely a
# presentation-layer summary of already-computed rule signals, never a
# decision-maker. The app works identically without this set; the button
# just won't produce a summary. Comma-separated list tries each key in order.
GROQ_API_KEYS=

# --- Receipts (finfluencer audits) ---
# SerpApi key: YouTube search, YouTube video + transcripts, Google Finance,
# Google Search and Google News. Get one at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Hard cap on real SerpApi calls per month (cached results are free).
SERPAPI_MONTHLY_BUDGET=200
# 1 = never call SerpApi; serve saved results only (how the public demo runs).
SERPAPI_OFFLINE=0
# GROQ_API_KEYS above is also used to pull stock picks out of transcripts.
